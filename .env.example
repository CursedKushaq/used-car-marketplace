# ── Application ─────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Database (PostgreSQL) ───────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autobazaar
# Neon serverless (production)
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/autobazaar?sslmode=require

# ── Meilisearch ─────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# ── Authentication ──────────────────────────────────
AUTH_SECRET=  # `openssl rand -base64 32`

# ── Sentry ──────────────────────────────────────────
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── PostHog ─────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── pg-boss (job queue — uses same DB by default) ───
PGBOSS_DATABASE_URL=${DATABASE_URL}

# ── Image upload (e.g. S3-compatible) ───────────────
UPLOAD_BUCKET=
UPLOAD_REGION=
UPLOAD_ACCESS_KEY_ID=
UPLOAD_SECRET_ACCESS_KEY=
UPLOAD_ENDPOINT=
